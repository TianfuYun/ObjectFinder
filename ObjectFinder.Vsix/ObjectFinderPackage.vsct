<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidObjectFinderPackage">
    <Buttons>
      <!-- Opens (or re-activates) the Object Finder window. Lives on the Tools menu. -->
      <Button guid="guidObjectFinderPackageCmdSet" id="ObjectFinderToolWindowCommandId" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_TOOLS_EXT_CUST" />
        <Icon guid="guidImages" id="bmpPicSearch" />
        <Strings>
          <ButtonText>Object Finder</ButtonText>
        </Strings>
      </Button>
    </Buttons>

    <Bitmaps>
      <Bitmap guid="guidImages" href="Resources\ObjectFinderToolWindowCommand.png" usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicX, bmpPicArrows, bmpPicStrikethrough" />
    </Bitmaps>
  </Commands>

  <!-- Default shortcut: Ctrl+Alt+F, global scope (so it also works while the query editor has focus).
       A shortcut the user assigns in Tools > Options > Environment > Keyboard takes precedence. -->
  <KeyBindings>
    <KeyBinding guid="guidObjectFinderPackageCmdSet" id="ObjectFinderToolWindowCommandId"
                editor="guidVSStd97" key1="F" mod1="Control Alt" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidObjectFinderPackage" value="{8b2e1f4e-c225-4688-aca7-88256cdbbd41}" />

    <GuidSymbol name="guidObjectFinderPackageCmdSet" value="{e55f3df0-a609-4d96-a90e-612ce3b1c0e8}">
      <IDSymbol name="ObjectFinderToolWindowCommandId" value="0x0100" />
    </GuidSymbol>

    <GuidSymbol name="guidImages" value="{a641cf3f-3164-42ac-b72f-0c8247b8ab81}">
      <IDSymbol name="bmpPic1" value="1" />
      <IDSymbol name="bmpPic2" value="2" />
      <IDSymbol name="bmpPicSearch" value="3" />
      <IDSymbol name="bmpPicX" value="4" />
      <IDSymbol name="bmpPicArrows" value="5" />
      <IDSymbol name="bmpPicStrikethrough" value="6" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
